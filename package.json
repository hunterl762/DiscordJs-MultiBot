{
  "name": "discordjs-multibot",
  "version": "3.1.0",
  "description": "Multi-purpose Discord bot upgraded to discord.js v14 with a MySQL-backed dashboard, verification, tickets, transcripts, and owner broadcasts.",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "check": "node scripts/check.js",
    "check:music": "node scripts/check-music.js",
    "test:music": "node scripts/music-smoke-test.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-mysql-session": "^3.0.3",
    "express-session": "^1.19.0",
    "mysql2": "^3.24.4",
    "@discordjs/voice": "^0.19.2",
    "@iamtraction/play-dl": "file:src/music/play-dl-adapter",
    "simple-ytdl-core": "1.1.1",
    "bgutils-js": "3.2.0",
    "googlevideo": "^4.1.1",
    "youtubei.js": "^18.1.0",
    "ffmpeg-static": "5.3.0",
    "opusscript": "^0.0.8",
    "prism-media": "^1.3.5"
  },
  "devDependencies": {},
  "keywords": [
    "discord",
    "discord.js",
    "dashboard",
    "mysql",
    "verification",
    "tickets",
    "transcripts",
    "broadcast"

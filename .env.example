# Discord bot application
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# OAuth callback configured in Discord Developer Portal > OAuth2 > Redirects.
# This must match EXACTLY, including http/https, hostname, port, path and trailing slash.
DISCORD_REDIRECT_URI=http://localhost:3000/auth/callback

# Web dashboard
PORT=3000
# Bind dashboard to all interfaces so it can be reached by the host/reverse proxy.
WEB_HOST=0.0.0.0
# Public dashboard URL used by OAuth, transcript links, canonical tags and embeds.
BASE_URL=http://localhost:3000
# Dashboard/navbar/browser-tab icon.
# May be a full URL (https://example.com/icon.png) or a path inside public/ (for example /icon.png).
# Leave blank to use the bot's live Discord profile picture.
WEB_ICON_URL=
# Optional 1200x630 social/Discord embed image. Falls back to the dashboard favicon when blank.
WEB_META_IMAGE_URL=

SESSION_SECRET=replace-with-a-long-random-secret
# Stable AES-256-GCM key source for encrypted dashboard configuration and OAuth session payloads.
DASHBOARD_ENCRYPTION_KEY=
# Legacy compatibility key for older encrypted AI credentials.
CREDENTIAL_ENCRYPTION_KEY=
NODE_ENV=development

# MySQL connection
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=multibot
MYSQL_PASSWORD=replace-with-a-strong-database-password
MYSQL_DATABASE=multibot
MYSQL_CONNECTION_LIMIT=10

# Automatically create missing tables at startup.
# Set false after you manage schema changes manually.
MYSQL_AUTO_MIGRATE=true

# Cache guild settings in memory to reduce database traffic.
SETTINGS_CACHE_TTL_MS=60000

# Slash-command registration
# Always register globally, then directly synchronize the same command set to every
# connected guild for immediate visibility and stale-schema repair.
SLASH_COMMAND_MULTI_GUILD_SYNC=true
# Delay between per-guild registrations to reduce Discord API pressure.
SLASH_COMMAND_SYNC_DELAY_MS=250
# Retry transient Discord API failures/rate limits.
SLASH_COMMAND_SYNC_RETRIES=3

# Optional defaults
DEFAULT_PREFIX=!

# Optional owner broadcast controls.
BOT_OWNER_IDS=
BROADCAST_DELAY_MS=400

# Maximum time allowed for one server's broadcast channel lookup/send before it is skipped.
BROADCAST_SERVER_TIMEOUT_MS=8000


# Twitch live announcements
# Create an application at https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# YouTube live alerts
# Create an API key with YouTube Data API v3 enabled.
YOUTUBE_API_KEY=

# Kick live alerts
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# Shared stream-alert poll interval in milliseconds. Minimum enforced by the bot: 60000.
STREAM_ALERT_CHECK_INTERVAL_MS=120000
# Live-role reconciliation interval. This repairs configured live roles from the
# stored stream state without making extra Twitch/YouTube/Kick API requests.
# Minimum enforced by the bot: 60000.
STREAM_ROLE_CHECK_INTERVAL_MS=120000
# Legacy Twitch-specific interval fallback.
TWITCH_CHECK_INTERVAL_MS=120000

# Music / Lavalink
MUSIC_ENABLED=false
LAVALINK_URL=127.0.0.1:2333
LAVALINK_PASSWORD=
LAVALINK_SECURE=false
LAVALINK_NODE_NAME=Kryndexa
# How long startup waits for Lavalink to emit its ready event.
LAVALINK_CONNECT_TIMEOUT_MS=15000
MUSIC_DEFAULT_SEARCH_ENGINE=youtube

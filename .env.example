# Discord bot application
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# OAuth callback configured in Discord Developer Portal > OAuth2 > Redirects.
# This must match EXACTLY, including http/https, hostname, port, path and trailing slash.
DISCORD_REDIRECT_URI=https://kryndexabot.xyz/auth/callback

# Web dashboard
PORT=3000
# Canonical public Kryndexa Bot URL used by OAuth, transcript links, canonical tags and embeds.
BASE_URL=https://kryndexabot.xyz
WEB_CANONICAL_HOST=kryndexabot.xyz
# Redirect alternate hosts to https://kryndexabot.xyz while preserving path/query.
# Recommended when the production panel is behind Cloudflare.
WEB_CANONICAL_REDIRECT=true
# Optional 1200x630 social/Discord embed image. Falls back to /favicon.ico when blank.
WEB_META_IMAGE_URL=

# Web panel HTTPS / SSL
# Option A: terminate SSL directly in Node by setting WEB_SSL_ENABLED=true.
# Option B: leave WEB_SSL_ENABLED=false when Cloudflare/NGINX/Caddy terminates HTTPS
# and set WEB_FORCE_HTTPS=true + WEB_TRUST_PROXY=true.
WEB_SSL_ENABLED=false
# SSL provider: standard or cloudflare-origin
WEB_SSL_PROVIDER=standard

# Standard certificate paths may be absolute or relative to the bot directory.
# Examples: certs/privkey.pem and certs/fullchain.pem
WEB_SSL_KEY_FILE=
WEB_SSL_CERT_FILE=

# Cloudflare Origin CA mode.
# Create the certificate in Cloudflare > SSL/TLS > Origin Server.
# Set WEB_SSL_PROVIDER=cloudflare-origin and point these to the PEM files.
WEB_CLOUDFLARE_ORIGIN_KEY_FILE=
WEB_CLOUDFLARE_ORIGIN_CERT_FILE=

# Cloudflare API certificate-pack monitoring shown on the dashboard.
# Leave CLOUDFLARE_ZONE_ID blank to resolve the zone automatically from CLOUDFLARE_ZONE_NAME.
# Automatic lookup requires the token to be able to read the zone.
CLOUDFLARE_ZONE_NAME=kryndexabot.xyz
CLOUDFLARE_ZONE_ID=
# Token must be able to read SSL/certificate data for the zone.
# If using automatic zone lookup, also grant Zone Read for kryndexabot.xyz.
CLOUDFLARE_API_TOKEN=

# Optional CA/intermediate chain when your certificate provider requires one.
WEB_SSL_CA_FILE=
# HTTPS port used when Node terminates TLS directly.
WEB_HTTPS_PORT=443
# If HTTPS port 443 is already owned by IIS/NGINX/Caddy/another service,
# Kryndexa can fall back to an internal HTTP port instead of crashing.
WEB_SSL_PORT_CONFLICT_FALLBACK=true
WEB_INTERNAL_PORT=3000
# Optional separate HTTP listener that redirects every request to HTTPS.
# Common production value when Node owns ports 80/443: 80
WEB_HTTP_REDIRECT_PORT=
# Redirect HTTP requests to HTTPS. Enable this behind a trusted reverse proxy or with direct SSL.
WEB_FORCE_HTTPS=true
# Honor X-Forwarded-Proto from one reverse-proxy hop (Cloudflare/NGINX/Caddy).
WEB_TRUST_PROXY=true
# Send Strict-Transport-Security on secure requests. Defaults on in NODE_ENV=production.
WEB_HSTS_ENABLED=true
# When false, invalid/mismatched direct SSL certificate files fall back to the internal
# HTTP listener instead of terminating the entire Discord bot.
WEB_SSL_STRICT_STARTUP=false

SESSION_SECRET=replace-with-a-long-random-secret
# Stable AES-256-GCM key source for encrypted dashboard configuration and OAuth session payloads.
DASHBOARD_ENCRYPTION_KEY=
# Legacy compatibility key for older encrypted AI credentials.
CREDENTIAL_ENCRYPTION_KEY=
NODE_ENV=development

# MySQL connection
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=multibot
MYSQL_PASSWORD=replace-with-a-strong-database-password
MYSQL_DATABASE=multibot
MYSQL_CONNECTION_LIMIT=10

# Automatically create missing tables at startup.
# Set false after you manage schema changes manually.
MYSQL_AUTO_MIGRATE=true

# Optional MySQL TLS/SSL settings
MYSQL_SSL=false
MYSQL_SSL_REJECT_UNAUTHORIZED=true
MYSQL_SSL_CA_FILE=

# Cache guild settings in memory to reduce database traffic.
SETTINGS_CACHE_TTL_MS=60000

# Slash-command registration
# Kryndexa always registers the full command set globally.
# Keep multi-guild sync enabled to also bulk-overwrite the same current command set
# into every connected server for immediate visibility and stale-schema repair.
SLASH_COMMAND_MULTI_GUILD_SYNC=true
# Delay between per-server bulk syncs to reduce Discord API pressure.
SLASH_COMMAND_SYNC_DELAY_MS=250
# Retries for rate limits / transient Discord API failures.
SLASH_COMMAND_SYNC_RETRIES=3

# Legacy development-guild setting. No longer required because the production
# synchronizer can update every connected guild.
DEV_GUILD_ID=

# Optional defaults
DEFAULT_PREFIX=!

# Optional owner broadcast controls.
BOT_OWNER_IDS=
BROADCAST_DELAY_MS=400

# Maximum time allowed for one server's broadcast channel lookup/send before it is skipped.
BROADCAST_SERVER_TIMEOUT_MS=8000


# Twitch live announcements
# Create an application at https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# YouTube live alerts
# Create an API key with YouTube Data API v3 enabled.
YOUTUBE_API_KEY=

# Kick live alerts
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# Shared stream-alert poll interval in milliseconds. Minimum enforced by the bot: 60000.
STREAM_ALERT_CHECK_INTERVAL_MS=120000
# Legacy Twitch-specific interval fallback.
TWITCH_CHECK_INTERVAL_MS=120000

# Music / Lavalink
MUSIC_ENABLED=false
LAVALINK_URL=localhost:2333
LAVALINK_PASSWORD=
LAVALINK_SECURE=false
LAVALINK_NODE_NAME=Kryndexa
MUSIC_DEFAULT_SEARCH_ENGINE=youtube

# Discord bot application
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# OAuth callback configured in the Discord Developer Portal
DISCORD_REDIRECT_URI=http://localhost:3000/auth/callback

# Web dashboard
PORT=3000
BASE_URL=http://localhost:3000
SESSION_SECRET=replace-with-a-long-random-secret

# Optional: register slash commands instantly in one test server.
# Leave blank for global registration.
DEV_GUILD_ID=

# Optional defaults
DEFAULT_PREFIX=!

# Optional owner broadcast controls.
# If blank, MultiBot verifies the Discord application owner automatically.
# For team-owned applications, provide one or more Discord user IDs separated by commas.
BOT_OWNER_IDS=

# Delay between cross-server announcement sends (milliseconds, minimum 100).
BROADCAST_DELAY_MS=400
